# Copy to .env next to compose.yaml on the server. Every site's Caddyfile reads these.

# The server's domain. The blog is served at it (and www.<DOMAIN>, which redirects to it),
# the statistics at stats.<DOMAIN>, Ente at photos., api.photos. and albums.<DOMAIN>.
# Must match DOMAIN in /srv/prabuddh-me/.env, which the blog's frontend uses for its links.
DOMAIN=prabuddh.in

# How long browsers remember to use only HTTPS (HSTS), in seconds. Caddy sends it on every
# response. It starts at an hour on purpose; raise it to a year (31536000) once HTTPS has
# worked for a while.
# HSTS_SECONDS=3600

# Who may open the Wagtail admin (/admin/), the Umami dashboard (stats.<DOMAIN>) and the
# blog's original uploaded photos (/media/original_images/): IP ranges separated by spaces.
# Everyone else gets "not found". The default lets everyone in. With Tailscale
# (the blog's docs/admin-access.md):
# ADMIN_ALLOWED_IPS=100.64.0.0/10 fd7a:115c:a1e0::/48
